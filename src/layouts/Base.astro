---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const u = (p = '') => base.replace(/\/$/, '') + '/' + p.replace(/^\//, '');
const { lang = 'zh', title, desc } = Astro.props;
const en = lang === 'en';
const T = en ? {
  brand: 'Yuanmingyuan Restoration', sub: '圆明园数字复原计划',
  nav: [['', 'Home'], ['gallery', 'Gallery'], ['method', 'Method'], ['contribute', 'Contribute']],
  defaultTitle: 'Yuanmingyuan Digital Restoration',
  defaultDesc: 'Rebuilding the Yuanmingyuan as it stood before 1860, scene by scene, from public-domain engravings and album paintings — open for anyone to complete.',
  footerAbout: 'An open, individual-led restoration project: reconstructing the Yuanmingyuan before 1860 from public-domain imagery, publishing the method, prompts and sources alongside every image.',
  links: 'Explore', links2: 'Project',
  gallery: 'Gallery', method: 'Method', contribute: 'Contribute',
  repo: 'GitHub repo ↗', issues: 'Claims & discussion ↗',
  copy: '© 2026 Yan Yuhuan',
  disclaimer: 'Images are AI-assisted scholarly reconstructions, not archaeological survey; not for restoration or academic citation.',
  switch: '中文',
} : {
  brand: '圆明园数字复原计划', sub: 'Yuanmingyuan Restoration',
  nav: [['', '首页'], ['gallery', '复原图册'], ['method', '复原方法'], ['contribute', '参与共建']],
  defaultTitle: '圆明园数字复原计划',
  defaultDesc: '以《圆明园四十景图咏》与《西洋楼二十景》铜版画为依据，逐景复原 1860 年前的圆明园，并开放给所有人共同拼完。',
  footerAbout: '一个个人发起的开放复原项目：以公有领域图像为据，逐景重建 1860 年前的圆明园，并把方法、提示词与出处一并公开。',
  links: '浏览', links2: '项目',
  gallery: '复原图册', method: '复原方法', contribute: '参与共建',
  repo: 'GitHub 仓库 ↗', issues: '认领与讨论 ↗',
  copy: '© 2026 严毓焕 / Yan Yuhuan',
  disclaimer: '本站图像为 AI 考据级复原，非考古测绘，不可作为修复或论文依据。',
  switch: 'EN',
};
const path = Astro.url.pathname.replace(base, '').replace(/^\/|\/$/g, '');
const switchHref = en ? u(path.replace(/^en\/?/, '')) : u('en/' + path);
const ogImage = new URL(u('og-cover.jpg'), Astro.site).href;
const repo = 'https://github.com/Ivan666jjj/yuanmingyuan-restoration';
---
<!doctype html>
<html lang={en ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title || T.defaultTitle}</title>
    <meta name="description" content={desc || T.defaultDesc} />
    <meta property="og:title" content={title || T.defaultTitle} />
    <meta property="og:description" content={desc || T.defaultDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={u(en ? 'en/' : '')} aria-label={T.brand}>
          <span class="seal">圆</span>
          <span><b>{T.brand}</b><span>{T.sub}</span></span>
        </a>
        <nav class="main">
          {T.nav.map(([href, label]) => <a href={u((en ? 'en/' : '') + href)} aria-current={path === ((en ? 'en/' : '') + href).replace(/\/$/, '') ? 'page' : undefined}>{label}</a>)}
          <a class="gh" href={switchHref}>{T.switch}</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site">
      <div class="wrap">
        <div class="top">
          <div class="brandcol"><b>{T.brand}</b>{T.footerAbout}</div>
          <div class="links">
            <a href={u((en ? 'en/' : '') + 'gallery')}>{T.gallery}</a>
            <a href={u((en ? 'en/' : '') + 'method')}>{T.method}</a>
            <a href={u((en ? 'en/' : '') + 'contribute')}>{T.contribute}</a>
          </div>
          <div class="links2">
            <a href={repo} target="_blank" rel="noopener">{T.repo}</a>
            <a href={`${repo}/issues`} target="_blank" rel="noopener">{T.issues}</a>
            <span>CC BY-SA 4.0 · MIT</span>
          </div>
        </div>
        <div class="bottom"><span>{T.copy}</span><span>{T.disclaimer}</span></div>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>