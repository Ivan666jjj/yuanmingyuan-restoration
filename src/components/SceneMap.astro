---
import scenes from '../data/scenes.json';
const base = import.meta.env.BASE_URL;
const u = (p) => base.replace(/\/$/, '') + '/' + p.replace(/^\//, '');
const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const done = scenes.scenes.filter((s) => s.status === 'done');
const open = scenes.scenes.filter((s) => s.status === 'open');
const total = scenes.scenes.length;
const pct = Math.round((done.length / total) * 100);
const PLAN_POS = {
  xieqiqu: [12.0, 64.0], yangquelong: [13.5, 59.2], wanhuazhen: [10.0, 49.2],
  fangwaiguan: [21.5, 54.5], wuzhuting: [24.5, 59.5], haiyantang: [39.0, 55.2],
  dashuifa: [51.5, 51.5], guanshuifa: [52.0, 55.0], yuanyingguan: [51.0, 46.8],
};
const L = en ? {
  restored: 'Restored', open: 'To claim', hint: 'Click a point for sources',
  overview: 'Three gardens', plan: 'Xiyang Lou plan',
  pick: 'Pick a scene', pickBody: 'Solid dots are restored; hollow dots await a contributor. Select one to see its sources and notes.',
  progress: 'PROGRESS', basis: 'Basis', model: 'Model', view: 'View full image', revise: 'Suggest revision',
  claimBody: 'Not yet restored. Use the sources above with any AI image tool, then submit it here.',
  claim: 'Claim this scene', attrib: 'Plan © Maximilian Dörrbecker / Wikimedia Commons · CC BY-SA 2.5',
  toClaim: 'To claim',
} : {
  restored: '已复原', open: '待认领', hint: '点击查看依据',
  overview: '三园示意', plan: '西洋楼精确图',
  pick: '从地图上选一景', pickBody: '实心圆为已复原，空心为待认领。选中后可看到参照文献、复原说明；未复原的可直接去 GitHub 认领。',
  progress: 'PROGRESS', basis: '依据', model: '模型', view: '查看大图', revise: '提出修订',
  claimBody: '这项复原尚未完成。可依据上述文献，用任意 AI 图像工具完成，再提交到本站。',
  claim: '认领这个景点', attrib: '平面图 © Maximilian Dörrbecker / Wikimedia Commons · CC BY-SA 2.5 · 编号与景点对应',
  toClaim: '待认领',
};
---
<div class="mapwrap" data-base={base} data-lang={lang}>
  <div>
    <div class="legend">
      <span><i></i>{L.restored} {done.length}</span>
      <span><i class="open"></i>{L.open} {open.length}</span>
      <span>{L.hint}</span>
      <span class="viewtoggle" role="group" aria-label="map view">
        <button class="vt" data-view="overview" aria-pressed="true">{L.overview}</button>
        <button class="vt" data-view="plan" aria-pressed="false">{L.plan}</button>
      </span>
    </div>
    <div class="planview" id="planview" hidden>
      <img src={u('images/maps/xiyanglou-plan.webp')} alt="Xiyang Lou plan (CC BY-SA 2.5)" />
      {scenes.scenes.filter((s) => PLAN_POS[s.id]).map((s) => (
        <button class:list={['hs', s.status]} data-id={s.id} style={`left:${PLAN_POS[s.id][0]}%;top:${PLAN_POS[s.id][1]}%`} aria-label={s.name}>
          <span class="dot"></span><span class="lbl">{en ? s.en : s.name}</span>
        </button>
      ))}
      <p class="small attrib">{L.attrib}</p>
    </div>
    <div class="mapcard" id="overview">
      <svg viewBox="0 0 1000 780" role="img" aria-label="Yuanmingyuan restoration map">
        <g transform="rotate(-4 500 400)">
          <path class="land" d="M60,120 H640 V560 H60 Z" />
          <path class="land" d="M640,100 H950 V400 H640 Z" />
          <path class="land" d="M600,420 H900 V720 H600 Z" />
          <rect class="xy" x="640" y="100" width="310" height="52" />
          <rect class="water" x="430" y="200" width="190" height="200" />
          <circle class="islet" cx="525" cy="300" r="10" />
          <rect class="water" x="250" y="260" width="150" height="100" />
          <rect class="water" x="250" y="470" width="150" height="70" />
          <circle class="water" cx="700" cy="260" r="40" />
          <path class="water" d="M770,210 H930 V380 H800 V300 H770 Z" />
          <ellipse class="water" cx="700" cy="560" rx="70" ry="50" />
          <ellipse class="water" cx="820" cy="500" rx="50" ry="35" />
          <text class="zone-label" x="80" y="152">{en ? 'YUANMING YUAN' : '圆明园'}</text>
          <text class="zone-label" x="660" y="192">{en ? 'CHANGCHUN YUAN' : '长春园'}</text>
          <text class="zone-label" x="620" y="452">{en ? 'QICHUN YUAN' : '绮春园'}</text>
          <text class="wlabel" x="480" y="305">{en ? 'Fu Hai' : '福海'}</text>
          <text class="wlabel" x="285" y="315">{en ? 'Hou Hu' : '后湖'}</text>
          <text class="wlabel" x="285" y="510">{en ? 'Qian Hu' : '前湖'}</text>
          <text class="wlabel" x="682" y="265">{en ? 'W. Lake' : '西湖'}</text>
          <text class="xylabel" x="700" y="130">{en ? 'XIYANG LOU' : '西洋楼'}</text>
          {scenes.scenes.map((s) => (
            <g class:list={['mk', s.status]} data-id={s.id} tabindex="0" role="button" aria-label={en ? s.en : s.name}>
              <circle class="dot" cx={s.x} cy={s.y} r={s.status === 'done' ? 6 : 4.5} />
              <text class="lbl" x={s.x + 10} y={s.y + 4}>{en ? s.en : s.name}</text>
            </g>
          ))}
        </g>
      </svg>
    </div>
  </div>

  <aside class="panel" id="panel" aria-live="polite">
    <div class="progress"><span>{L.progress}</span><span>{done.length}/{total} · {pct}%</span></div>
    <div class="bar" style="margin:12px 0 22px"><i style={`width:${pct}%`}></i></div>
    <div class="empty"><h3>{L.pick}</h3><p class="kv">{L.pickBody}</p></div>
  </aside>
</div>

<script type="application/json" id="scene-data" set:html={JSON.stringify(scenes.scenes)}></script>
<script type="application/json" id="map-i18n" set:html={JSON.stringify(L)}></script>
<script>
  const root = document.querySelector('.mapwrap');
  const BASE = root.getAttribute('data-base') || '/';
  const EN = root.getAttribute('data-lang') === 'en';
  const L = JSON.parse(document.getElementById('map-i18n').textContent);
  const scenes = JSON.parse(document.getElementById('scene-data').textContent);
  const byId = Object.fromEntries(scenes.map((s) => [s.id, s]));
  const panel = document.getElementById('panel');
  const repo = 'https://github.com/Ivan666jjj/yuanmingyuan-restoration';
  const asset = (p) => BASE.replace(/\/$/, '') + p;
  const doneCount = scenes.filter((s) => s.status === 'done').length;
  const pct = Math.round((doneCount / scenes.length) * 100);
  const name = (s) => EN ? s.en : s.name;
  const esc = (t) => String(t ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function render(s) {
    panel.innerHTML = `
      <div class="progress"><span>${esc(s.garden)}</span><span>${doneCount}/${scenes.length} · ${pct}%</span></div>
      <div class="bar" style="margin:12px 0 18px"><i style="width:${pct}%"></i></div>
      ${s.status === 'done' ? `<img src="${asset(s.thumb)}" alt="${esc(name(s))}" loading="lazy" />` : ''}
      <h3>${esc(name(s))}</h3>
      <div class="sub">${esc(s.category)}${s.status === 'open' ? ' · ' + L.toClaim : ''}</div>
      <div class="kv"><b>${L.basis}</b>　${esc(s.ref)}</div>
      ${s.status === 'done' ? `
        <div class="kv"><b>${L.model}</b>　${esc(s.model)} · 2940×1912</div>
        <div class="kv" style="margin-top:14px">${esc(s.prompt)}</div>
        <div class="actions">
          <a class="btn ghost" href="${asset(s.image)}" target="_blank" rel="noopener">${L.view}</a>
          <a class="link-arrow" href="${repo}/issues/new?template=claim-scene.yml&title=${encodeURIComponent((EN ? 'Revise: ' : '修订：') + name(s))}" target="_blank" rel="noopener">${L.revise}</a>
        </div>` : `
        <p class="kv" style="margin-top:14px">${L.claimBody}</p>
        <div class="actions"><a class="btn red" href="${repo}/issues/new?template=claim-scene.yml&title=${encodeURIComponent((EN ? 'Claim: ' : '认领：') + name(s))}" target="_blank" rel="noopener">${L.claim}</a></div>`}
    `;
  }

  const activate = (el, s) => {
    document.querySelectorAll('.hs.active,.mk.active').forEach((x) => x.classList.remove('active'));
    el.classList.add('active');
    render(s);
  };
  document.querySelectorAll('.mk').forEach((el) => {
    const s = byId[el.dataset.id];
    el.addEventListener('click', () => activate(el, s));
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(el, s); } });
  });

  const planview = document.getElementById('planview');
  const overview = document.getElementById('overview');
  const vts = document.querySelectorAll('.vt');
  function setView(v) {
    vts.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
    planview.hidden = v !== 'plan';
    overview.hidden = v === 'plan';
  }
  vts.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));
  if (location.hash === '#plan') setView('plan');

  document.querySelectorAll('.hs').forEach((el) => {
    el.addEventListener('click', () => activate(el, byId[el.dataset.id]));
  });
</script>